# MCP Server Configuration (HTTP/SSE Transport)
# This file contains environment variables for the Tennis Booking MCP Server

# Flask API Base URL (internal, localhost)
FLASK_API_BASE_URL=http://localhost:5001

# Service User Token for authenticated endpoints
# This token is used for searches that require authentication
# Replace with actual service user token after creating a service account
MCP_SERVICE_USER_TOKEN=

# MCP Server Port (HTTP/SSE server listens on this port)
MCP_SERVER_PORT=8765

# Optional API Key for MCP endpoint authentication
# Leave empty to allow open access (useful for testing)
# Set a secure random string for production
MCP_API_KEY=
