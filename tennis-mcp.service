[Unit]
Description=Tennis Booking MCP Server (HTTP/SSE)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/Tennis_Booking
EnvironmentFile=/opt/Tennis_Booking/mcp_config.env
ExecStart=/opt/Tennis_Booking/venv/bin/python /opt/Tennis_Booking/mcp_server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tennis-mcp

[Install]
WantedBy=multi-user.target
